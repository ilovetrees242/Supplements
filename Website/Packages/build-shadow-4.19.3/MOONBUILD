#!/bin/bash
source "$VEILERDBPATH/sync/shadow/info"
trap 'echo -e "${BLUE}Interrupted. Goodbye!${NC}"; exit 1' INT && set -e
case $1 in
    build)
        CONFIGPARAMS=()
        for FLAG in ${USEFLAGS[@]}; do
            case $FLAG in
                +GNULD)
                    CONFIGPARAMS+=("--with-gnu-ld")
                ;;
            esac
        done
        # configure command goes here
        sed -i 's/groups$(EXEEXT) //' src/Makefile.in

        find man -name Makefile.in -exec sed -i 's/groups\.1 / /'   {} \;
        find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
        find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

        sed -e 's@#ENCRYPT_METHOD DES@ENCRYPT_METHOD YESCRYPT@' -e 's@/var/spool/mail@/var/mail@' -e '/PATH=/{s@/sbin:@@;s@/bin:@@}' -i etc/login.defs

        ./configure --sysconfdir=/etc --with-libpam --disable-static --without-libbsd --with-{b,yes}crypt
        # build command goes here
        make
    ;;
    install)
        # install command goes here
        DESTDIR=$PWD/DEST make exec_prefix=/usr pamdir= install
        DESTDIR=$PWD/DEST make -C man install-man
    ;;
esac
set +e
