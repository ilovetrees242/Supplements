#!/bin/bash
source "$VEILERDBPATH/sync/inetutils/info"
trap 'echo -e "${BLUE}Interrupted. Goodbye!${NC}"; exit 1' INT && set -e
case $1 in
    build)
        CONFIGPARAMS=()
        for FLAG in ${USEFLAGS[@]}; do
            case $FLAG in
                +SYSTEMD)
                    CONFIGPARAMS+=("--enable-systemd")
                ;;
                -RPATH)
                    CONFIGPARAMS+=("--disable-rpath")
                ;;
            esac
        done
        # configure command goes here
        sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c
        ./configure --prefix=$VEILERPREFIX --bindir=$VEILERPREFIX/bin --localstatedir=/var --disable-logger --disable-whois --disable-rcp --disable-rexec --disable-rlogin --disable-rsh --disable-servers ${CONFIGPARAMS[@]}
        # build command goes here
        make
        if [ $VEILERTESTS -eq 1 ]; then
            make check
        fi
    ;;
    install)
        # install command goes here
        make DESTDIR=$PWD/DEST install
        mv -v DEST/usr/bin/ifconfig DEST/usr/sbin
    ;;
esac
set +e
