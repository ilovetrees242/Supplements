#!/bin/bash
source "$VEILERDBPATH/sync/wheel/info"
trap 'echo -e "${BLUE}Interrupted. Goodbye!${NC}"; exit 1' INT && set -e
case $1 in
    build)
        # configure command goes here
        pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
        # build command goes here
    ;;
    install)
        # install command goes here
        pip3 install --prefix=$VEILERPREFIX --no-deps --no-warn-script-location --root=$PWD/DEST --force-reinstall --no-index --find-links dist wheel
    ;;
esac
set +e
